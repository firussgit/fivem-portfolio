# Example server.cfg for the portfolio resources. Copy it next to your FXServer as server.cfg.
# Start the server with OneSync as a launch argument (it cannot be set from this file):
#   FXServer.exe +set onesync on +exec server.cfg

endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"

sv_hostname "Portfolio Dev Server"
sv_maxclients 4
set sv_enforceGameBuild 3258

# Get a free key at https://keymaster.fivem.net
sv_licenseKey "YOUR_LICENSE_KEY_HERE"

# --- database (matches docker-compose.yml) ---
set mysql_connection_string "mysql://root:fivem_dev_password@127.0.0.1:3307/fivem"

# --- optional tuning ---
set jobs_pay_interval_minutes 15      # paychecks (jobs-cs)
set jobs_require_vehicle 1            # courier/taxi runs need a vehicle (0 = allow on foot)
set ems_revive_pay 200                # bank bonus for an EMS revive (0 = none)
set ems_revive_cooldown_seconds 60    # minimum gap before the same patient can be revived again
set mechanic_repair_pay 250           # bank fee for a mechanic repair (consumes a repair kit)
set police_fine_max 2500              # largest fine a police officer can issue
set garage_hotwire_seconds 8          # how long a lockpick takes to hotwire a stolen car
set garage_max_keys 5                 # most players who can be given a key to one vehicle
set insurance_payout_percent 50       # share of the repair cost paid on an insurance claim
set insurance_payout_max 2500         # hard cap on one claim settlement
set insurance_deductible 250          # taken off each claim settlement
set insurance_claim_cooldown_minutes 30 # minimum gap between claims on the same vehicle
set needs_tick_seconds 60             # hunger / thirst decay (needs-cs)
set shops_restock_minutes 5           # shop restock (shops-cs)
set dispatch_pay_per_call 150         # bank bonus for a resolved dispatch call (0 = none)
set dispatch_scene_radius 40          # metres: how close a unit must be to mark on scene / resolve
set dispatch_call_ttl_minutes 15      # calls left open this long expire
set dispatch_call_cooldown_seconds 20 # minimum gap between a player's 911 calls
set dealer_showroom_x -45.0           # dealership showroom position (dealer-cs)
set dealer_showroom_y -1098.0
set dealer_showroom_z 26.4
set dealer_range 8                    # metres: how close a player must be to buy / sell / test drive
set dealer_testdrive_seconds 90       # test drive limit
set dealer_sell_min_percent 35        # trade-in offer for a wrecked car
set dealer_sell_max_percent 60        # trade-in offer for a perfect car
set dealer_rent_minutes 20            # rental length in minutes
set dealer_rent_fee_percent 4         # rental fee as a percent of the catalogue price
set dealer_rent_deposit_percent 10    # refundable deposit as a percent of the catalogue price
set dealer_rent_deposit_max 5000      # deposit cap

# First SuperAdmin for admin-cs: your Rockstar licence, e.g. license:xxxxxxxxxxxxxxxx (see /id after joining)
# set admin_bootstrap_license "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- base resources (from cfx-server-data) ---
ensure mapmanager
ensure chat
ensure spawnmanager
ensure basic-gamemode
ensure baseevents

# --- database driver (https://github.com/overextended/oxmysql/releases) ---
ensure oxmysql

# --- portfolio resources (order matters: dependencies first) ---
ensure hello-lua
ensure bank-cs
ensure inventory-cs
ensure jobs-cs
ensure needs-cs
ensure shops-cs
ensure garage-cs
ensure customs-cs
ensure fuel-cs
ensure phone-cs
ensure dispatch-cs
ensure races-cs
ensure spawn-core
ensure dealer-cs
ensure admin-cs

# --- permissions ---
# Placement and test commands (/setshop, /setcustoms, /setfuel, /setworkhub, /atmscan, /givecar, /giveitem, /setjob, /setneeds, /car, /dispatchtest, /dispatchclose)
# check these ACEs. For a LOCAL TEST SERVER ONLY, uncomment the block below so everyone may use them;
# on a real server grant them to a staff group instead (see the README).
#add_ace builtin.everyone garage.admin allow
#add_ace builtin.everyone jobs.admin allow
#add_ace builtin.everyone spawn.admin allow
#add_ace builtin.everyone bank.admin allow
#add_ace builtin.everyone inventory.admin allow
#add_ace builtin.everyone shops.admin allow
#add_ace builtin.everyone needs.admin allow
#add_ace builtin.everyone customs.admin allow
#add_ace builtin.everyone fuel.admin allow
#add_ace builtin.everyone dispatch.admin allow
#add_ace builtin.everyone dispatch.test allow
